# Strikerr Environment Configuration

# Server
SERVER_PORT=8080
GIN_MODE=debug

# Database (PostgreSQL)
DATABASE_URL=postgres://strikerr:strikerr_secret@localhost:5432/strikerr_db?sslmode=disable

# Task Queue (Redis)
REDIS_URL=localhost:6379

# Proxy & Egress Shield
PROXY_URL=http://user:pass@proxy.residential-provider.com:8080

# Forensic TSA & Reporting
TSA_URL=https://freetsa.org/tsr
SMTP_RELAY_HOST=smtp.sendgrid.net:587
SMTP_USER=apikey
SMTP_PASS=your_api_key_here
SENDER_EMAIL=aduan-siber@strikerr.org
