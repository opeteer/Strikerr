# ==============================================================================
# STRIKERR ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Core Django Settings
DEBUG=True
SECRET_KEY=strikerr-dev-insecure-key-change-in-production-^9#z!k1@0
DJANGO_SETTINGS_MODULE=strikerr.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Primary PostgreSQL Database
DATABASE_URL=postgresql://strikerr_usr:strikerr_secret_pw@localhost:5432/strikerr_db

# Task Queue & Broker (RabbitMQ)
RABBITMQ_URL=amqp://strikerr_rmq:strikerr_rmq_pw@localhost:5672//

# Caching & Django Channels (Redis)
REDIS_URL=redis://:strikerr_redis_pw@localhost:6379/0

# MinIO / AWS S3 Evidence Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=strikerr_minio_admin
MINIO_SECRET_KEY=strikerr_minio_secret_key
MINIO_BUCKET_NAME=strikerr-artifacts
MINIO_USE_SSL=False

# Egress Proxies (Indonesian Residential / Mobile 4G)
# Format: socks5h://user:pass@host:port (enforcing remote DNS resolution)
ID_RESIDENTIAL_PROXY_URL=socks5h://test_user:test_pass@127.0.0.1:1080
PROXY_ROTATOR_ENABLED=False

# OpSec & Sandbox Guardrails
CRAWLER_TIMEOUT_SECONDS=12
MAX_REDIRECT_HOPS=5
MAX_DOM_NODES=25000
MAX_DOM_DEPTH=64
MAX_EXPANDED_STREAM_BYTES=31457280

# External Feeds & API Keys (Optional)
VIRUSTOTAL_API_KEY=
URLSCAN_API_KEY=
GOOGLE_SAFE_BROWSING_KEY=
KOMDIGI_ADUAN_EMAIL=aduankonten@komdigi.go.id
PANDI_ABUSE_EMAIL=abuse@pandi.id
BSSN_CSIRT_EMAIL=csirt@bssn.go.id
